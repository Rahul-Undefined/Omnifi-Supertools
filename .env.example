# Omnifi SuperTools — server environment
# Copy to .env.local for development. Never commit real secrets.

# --- Sessions -------------------------------------------------------------
# 32+ random characters. Required in production. Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=12

# --- Authentication -------------------------------------------------------
# local  : username/password accounts defined below (default)
# header : trust identity headers set by an SSO reverse proxy (Azure AD App Proxy, oauth2-proxy)
AUTH_MODE=local
# Admin account for AUTH_MODE=local. Leave ADMIN_PASSWORD empty to disable sign-in.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Extra accounts as JSON. passwordHash from: node scripts/hash-password.mjs "secret"
# USERS_JSON=[{"username":"rahul","name":"Rahul Ojha","email":"rahul@myomnifi.com","role":"admin","passwordHash":"scrypt$..."}]
# Microsoft 365 sign-in (Entra ID). Create an app registration, add redirect URI
#   https://<your-host>/api/auth/microsoft/callback  (type: Web), then:
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
# Only these email domains may sign in with Microsoft
AUTH_ALLOWED_DOMAINS=myomnifi.com
# Emails that get the admin role on Microsoft sign-in
ADMIN_EMAILS=
# Public URL used for the OAuth redirect (derived from the request when empty)
APP_URL=
# "Keep me signed in" length
SESSION_REMEMBER_DAYS=30
# Video downloader (yt-dlp + FFmpeg are in the Docker image; locally install them yourself)
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
# Optional: contents of a Netscape cookies.txt exported from a signed-in browser, for sites that block anonymous cloud downloads
YTDLP_COOKIES=
# Optional proxy used only by the downloader (http://user:pass@host:port or socks5://...)
YTDLP_PROXY=
VIDEO_MAX_MB=1024
VIDEO_TIMEOUT_MIN=15
VIDEO_CONCURRENCY=2
# For AUTH_MODE=header:
AUTH_HEADER_USER=x-forwarded-user
AUTH_HEADER_EMAIL=x-forwarded-email
# Comma-separated emails that get the admin role in header mode
AUTH_ADMINS=

# --- AI (never exposed to the browser) ------------------------------------
# anthropic | openai | openai-compatible | (empty = AI tools show "not configured")
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For openai-compatible gateways (Azure OpenAI via gateway, Ollama, vLLM):
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MAX_INPUT_CHARS=120000

# --- Storage --------------------------------------------------------------
# PostgreSQL for usage/audit data. Leave empty to use a JSON file under DATA_DIR.
DATABASE_URL=
DATA_DIR=.data

# --- Web tools ------------------------------------------------------------
WEB_FETCH_TIMEOUT_MS=10000
WEB_MAX_BYTES=2097152

# --- Rate limits (per user or IP, per minute) -----------------------------
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_WEB_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=10

# --- Client ---------------------------------------------------------------
# Self-host the FFmpeg WebAssembly core on the intranet (copy node_modules/@ffmpeg/core/dist/umd)
# NEXT_PUBLIC_FFMPEG_CORE_URL=https://supertools.omnifi.internal/ffmpeg
